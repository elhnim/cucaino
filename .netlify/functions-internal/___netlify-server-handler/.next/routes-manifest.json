      "regex": "^/kid/([^/]+?)/practice/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkidId": "nxtPkidId",
        "nxtPtaskId": "nxtPtaskId"
      },
      "namedRegex": "^/kid/(?<nxtPkidId>[^/]+?)/practice/(?<nxtPtaskId>[^/]+?)(?:/)?$"
    },
    {
