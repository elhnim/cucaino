# Cucaino — environment variables
# Copy this file to `.env.local` and fill in real values.

# Supabase project credentials. Get these from:
#   Supabase Dashboard → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Public URL of this deployment — used in email invite links.
# Netlify sets $URL automatically; only needed for local dev or custom domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Invest feature - Finnhub free tier (US stock quotes + company news). Server-only.
# Get a free key at https://finnhub.io . CoinGecko + Yahoo need no key.
FINNHUB_API_KEY=

# AI Arcade (server-only). ANTHROPIC_API_KEY powers the games.
ANTHROPIC_API_KEY=
# Key for sealing game state sent to the browser (Mystery Detective solution, Doodle Guess
# round). Any long random string, e.g. `openssl rand -base64 32`. If unset, a key is derived
# from SUPABASE_SERVICE_ROLE_KEY / ANTHROPIC_API_KEY (rotating those then voids games in progress).
ARCADE_SECRET=
# Enables POST /api/arcade-playtest (prompt play-testing against the real model) when set
# (16+ chars). Leave EMPTY in production unless you are actively play-testing.
ARCADE_PLAYTEST_TOKEN=
